{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hone Skill Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "skill",
    "caseId",
    "reviewer",
    "reviewedAt",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "pattern": "^hone:"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "criterionNotes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "questionNotes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
